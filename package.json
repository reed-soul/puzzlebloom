{
  "name": "puzzlebloom",
  "version": "0.1.0",
  "private": true,
  "description": "A garden of calm puzzle games for curious kids. Static-first, no accounts, no ads.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @puzzlebloom/web dev",
    "build": "pnpm --filter @puzzlebloom/web build",
    "preview": "pnpm --filter @puzzlebloom/web preview",
    "typecheck": "pnpm --filter @puzzlebloom/web typecheck",
    "test": "pnpm --filter @puzzlebloom/sudoku-engine test",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "puzzle",
    "kids",
    "sudoku",
    "monorepo",
    "static-site"
  ],
  "license": "MIT"
}
