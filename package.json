{
  "name": "puzzlebloom",
  "version": "0.1.0",
  "private": true,
  "description": "A garden of calm puzzle games for curious kids. Static-first, no accounts, no ads.",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter @puzzlebloom/web dev",
    "build": "pnpm --filter @puzzlebloom/web build",
    "preview": "pnpm --filter @puzzlebloom/web preview",
    "typecheck": "pnpm --filter @puzzlebloom/web typecheck && pnpm --filter @puzzlebloom/web exec tsc -p ../../e2e",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "test": "pnpm --filter @puzzlebloom/sudoku-engine test && pnpm --filter @puzzlebloom/theme-core test",
    "test:e2e": "pnpm run build:seo && playwright test",
    "test:live": "PB_BASE_URL=${PB_BASE_URL:-https://puzzlebloom.taoliapp.com} playwright test",
    "deploy": "pnpm run build:seo && npx --yes wrangler@4 pages deploy && node scripts/indexnow.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build:seo",
    "build:seo": "pnpm run build && node scripts/seo.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "keywords": [
    "puzzle",
    "kids",
    "sudoku",
    "monorepo",
    "static-site"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1"
  }
}
